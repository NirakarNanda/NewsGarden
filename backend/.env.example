# ─────────────────────────────────────────────
# NewsGarden backend environment
# Copy to .env and fill in what you need.
# ─────────────────────────────────────────────

# --- Server ---
PORT=4000
# Backwards-compatible single origin. Prefer CORS_ORIGINS below.
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS allowlist. Defaults cover local dev
# (localhost, 127.0.0.1, and Next.js's port rollover to 3001).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# --- Database (required) ---
MONGODB_URI=mongodb://localhost:27017/newsgarden

# --- API key (optional) ---
# When set, the mutating approval routes
# (POST /api/approval/:editionId/approve|revise|publish)
# require a matching `x-api-key` request header.
# When empty, those routes pass through (local dev default).
# Read-only GET routes are always open for the campus UI.
API_KEY=

# --- AI provider (used by every generative/judgement agent) ---
# ollama = fully local, no key needed (default)
# gemini = Google Gemini cloud, requires GEMINI_API_KEY
# openai = any OpenAI-compatible HTTP API (Groq, OpenRouter, Cerebras, ...),
#          requires AI_BASE_URL, AI_API_KEY and AI_MODEL below
AI_PROVIDER=ollama

# Only needed when AI_PROVIDER=gemini.
# Read from the environment at call time (never hardcoded).
GEMINI_API_KEY=

# Only used when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Only used when AI_PROVIDER=openai.
# Free examples:
#   Groq (generous free tier):       AI_BASE_URL=https://api.groq.com/openai/v1
#                                    AI_MODEL=openai/gpt-oss-120b
#   OpenRouter (free :free models):  AI_BASE_URL=https://openrouter.ai/api/v1
#                                    AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Keys are read from the environment at call time (never hardcoded).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Scheduling ---
# Cron expression for the daily edition run (07:00 daily).
DAILY_EDITION_CRON=0 7 * * *
# How often agents report liveness (milliseconds).
HEARTBEAT_INTERVAL_MS=15000

# Run an edition build once at startup (default: false).
RUN_ON_START=false

# Max concurrent AI calls process-wide (default: 4).
AI_MAX_CONCURRENCY=4

# Days before ActivityEvent documents expire (default: 30).
# Set to 0 to disable expiry.
ACTIVITY_EVENT_TTL_DAYS=30

# Approval notification email. When unset, the notification is printed
# to the server console instead of sent. Real sending additionally
# requires `npm install nodemailer` (it is not a dependency).
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=newsroom@example.com

# --- Image generation (optional) ---
# Article images are resolved in this order:
#   1. A real AI image provider, when IMAGE_PROVIDER names an implemented
#      provider and IMAGE_API_KEY is set. No AI provider is implemented yet,
#      so those names are only reserved.
#   2. A free topical image from Wikimedia Commons (no key needed) —
#      attribution is saved with the article and shown under the image.
#   3. A deterministic inline-SVG placeholder (offline-safe).
# IMAGE_PROVIDER=web (default) | placeholder | <reserved AI provider name>
# Set to "placeholder" to skip the Commons lookup entirely.
#IMAGE_PROVIDER=web
#IMAGE_API_KEY=

# ─────────────────────────────────────────────
# NewsGarden backend environment
# Copy to .env and fill in what you need.
# ─────────────────────────────────────────────

# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database (required) ---
MONGODB_URI=mongodb://localhost:27017/newsgarden

# --- API key (optional) ---
# When set, the mutating approval routes
# (POST /api/approval/:editionId/approve|revise|publish)
# require a matching `x-api-key` request header.
# When empty, those routes pass through (local dev default).
# Read-only GET routes are always open for the campus UI.
API_KEY=

# --- AI provider (used by every generative/judgement agent) ---
# ollama = fully local, no key needed (default)
# gemini = Google Gemini cloud, requires GEMINI_API_KEY
AI_PROVIDER=ollama

# Only needed when AI_PROVIDER=gemini.
# Read from the environment at call time (never hardcoded).
GEMINI_API_KEY=

# Only used when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Scheduling ---
# Cron expression for the daily edition run (07:00 daily).
DAILY_EDITION_CRON=0 7 * * *
# How often agents report liveness (milliseconds).
HEARTBEAT_INTERVAL_MS=15000
